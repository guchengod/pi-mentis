{
  "name": "pi-mentis-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Pi-aware personal long-term memory with coding-agent work as the first-priority scenario",
  "license": "MIT",
  "author": "guchengod",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guchengod/pi-mentis.git"
  },
  "homepage": "https://github.com/guchengod/pi-mentis#readme",
  "bugs": {
    "url": "https://github.com/guchengod/pi-mentis/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "acceptance": "node scripts/acceptance/run.mjs",
    "build": "turbo run build",
    "evidence:classless": "pnpm build && node scripts/classless-evidence.mjs",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 && node scripts/check-workspace.mjs",
    "pack:extensions": "node scripts/pack-extensions.mjs",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:e2e:live": "node scripts/live-e2e.mjs relationship",
    "test:coverage": "vitest run --project unit --project e2e --coverage --coverage.reporter=text --coverage.reporter=json-summary",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.0",
    "@earendil-works/pi-ai": "0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "fast-check": "4.9.0",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "turbo": "2.10.7",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@earendil-works/pi-ai": "0.84.0",
      "@earendil-works/pi-coding-agent": "0.84.0"
    },
    "onlyBuiltDependencies": [
      "@zvec/zvec"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "@emnapi/core": "1.11.1",
        "@emnapi/runtime": "1.11.1"
      }
    }
  }
}
