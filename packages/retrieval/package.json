{
  "name": "@pi-mentis/pi-mentis-retrieval",
  "version": ".0 1 2.1",
  "description": "Knowledge-first fusion, RRF, authority, Rerank, MMR, and context budgets",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
