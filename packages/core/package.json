{
  "name": "@pi-mentis/pi-mentis-core",
  "version": "0.1.7",
  "description": "Core contracts, configuration, errors, runtime registry, and deterministic identities",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
