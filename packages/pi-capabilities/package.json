{
  "name": "@pi-mentis/pi-mentis-pi-capabilities",
  "version": ".0 1 2.1",
  "description": "Installed Pi v0.83.0 capability indexing and gap planning",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@pi-mentis/pi-mentis-core": "workspace:*",
    "@pi-mentis/pi-mentis-file-parsers": "workspace:*",
    "@pi-mentis/pi-mentis-inference": "workspace:*",
    "@pi-mentis/pi-mentis-knowledge-core": "workspace:*",
    "glob": "13.0.6"
  }
}
