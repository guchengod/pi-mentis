{
  "name": "@pi-mentis/pi-mentis-observability",
  "version": "0.1.5",
  "description": "Sensitive-content-safe metrics, tracing, and diagnostics",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@pi-mentis/pi-mentis-core": "workspace:*"
  }
}
