{
  "name": "@pi-mentis/pi-mentis-knowledge-core",
  "version": "0.1.1",
  "description": "Knowledge ingestion, revisioning, incremental indexing, and search",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@pi-mentis/pi-mentis-core": "workspace:*",
    "@pi-mentis/pi-mentis-file-parsers": "workspace:*",
    "@pi-mentis/pi-mentis-inference": "workspace:*",
    "@pi-mentis/pi-mentis-observability": "workspace:*",
    "@pi-mentis/pi-mentis-zvec": "workspace:*",
    "glob": "13.0.6"
  }
}
