{
  "name": "@galvinsan/pi-mentis-memory",
  "version": "0.1.51",
  "description": "Standalone Pi Mentis memory extension for Pi >= 0.84.0",
  "license": "MIT",
  "author": "guchengod",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guchengod/pi-mentis.git",
    "directory": "packages/pi-memory-extension"
  },
  "homepage": "https://github.com/guchengod/pi-mentis#readme",
  "bugs": {
    "url": "https://github.com/guchengod/pi-mentis/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "memory",
    "agent",
    "zvec",
    "long-term-memory"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --external @earendil-works/pi-ai --external @earendil-works/pi-coding-agent --external typebox --external @zvec/zvec --external proper-lockfile",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@zvec/zvec": "0.6.0",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@pi-mentis/pi-mentis-core": "workspace:*",
    "@pi-mentis/pi-mentis-inference": "workspace:*",
    "@pi-mentis/pi-mentis-memory-core": "workspace:*",
    "@pi-mentis/pi-mentis-observability": "workspace:*",
    "@pi-mentis/pi-mentis-pi-extension-support": "workspace:*",
    "@pi-mentis/pi-mentis-retrieval": "workspace:*",
    "@pi-mentis/pi-mentis-siliconflow": "workspace:*",
    "@pi-mentis/pi-mentis-zvec": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
