{
  "name": "@pi-mentis/pi-mentis-memory-core",
  "version": "0.1.7",
  "description": "Evidence-bound durable memory, capture, conflict, and reinforcement",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@pi-mentis/pi-mentis-core": "workspace:*",
    "@pi-mentis/pi-mentis-inference": "workspace:*",
    "@pi-mentis/pi-mentis-observability": "workspace:*",
    "@pi-mentis/pi-mentis-zvec": "workspace:*"
  }
}
